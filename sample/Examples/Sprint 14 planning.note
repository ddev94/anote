lor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"The importer ships behind a flag.","styles":{"bold":true}},{"type":"text","text":" Off by default, on for two accounts who asked for it.","styles":{}}],"children":[]},{"id":"b2b608e1-a99d-42be-a599-a9542f4842c5","type":"numberedListItem","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"`INC-4412`'s remaining audit is this sprint, not next.","styles":{"bold":true}},{"type":"text","text":" Four callers, one afternoon.","styles":{}}],"children":[]},{"id":"39910e3d-9945-4f44-99ac-58e8e5c046fb","type":"numberedListItem","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Table column widths are worth the schema change.","styles":{"bold":true}},{"type":"text","text":" Kenji has the migration written.","styles":{}}],"children":[]},{"id":"dde3aea1-2c48-4778-97ca-ea9636622901","type":"numberedListItem","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"No sprint goal about the redesign.","styles":{"bold":true}},{"type":"text","text":" It has no design yet; carrying it as a goal was fiction.","styles":{}}],"children":[]},{"id":"4f323420-7b39-4015-9fc3-847ef4732b99","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":2,"isToggleable":false},"content":[{"type":"text","text":"Carried in","styles":{}}],"children":[]},{"id":"4a5aed39-9695-44ee-b9e8-60383696254b","type":"bulletListItem","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"#4390","styles":{"code":true}},{"type":"text","text":" importer: mapping UI — Mai, 3 days left","styles":{}}],"children":[]},{"id":"8c63d861-e195-40c0-a1d6-79c8c3e2d221","type":"bulletListItem","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"#4402","styles":{"code":true}},{"type":"text","text":" slow query audit — Duong","styles":{}}],"children":[]},{"id":"8a02da89-9b4e-49a8-9d67-80cb929fb885","type":"bulletListItem","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"#4377","styles":{"code":true}},{"type":"text","text":" table widths in the note format — Kenji","styles":{}}],"children":[]},{"id":"f88e1a77-f194-4ce1-aa2d-bb710f379b28","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":2,"isToggleable":false},"content":[{"type":"text","text":"Action items","styles":{}}],"children":[]},{"id":"3552b93f-9e47-42f9-8032-52236f9227f1","type":"checkListItem","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","checked":false},"content":[{"type":"text","text":"Mai: flag name and the two accounts, in ","styles":{}},{"type":"text","text":"#4390","styles":{"code":true}},{"type":"text","text":", by Tuesday","styles":{}}],"children":[]},{"id":"5e264678-32bd-4f53-8b7a-9a249d797a29","type":"checkListItem","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","checked":false},"content":[{"type":"text","text":"Duong: the four callers, with a test each","styles":{}}],"children":[]},{"id":"a52a7423-0270-41aa-b127-7efd6f4ae1f0","type":"checkListItem","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","checked":false},"content":[{"type":"text","text":"Kenji: migration behind ","styles":{}},{"type":"text","text":"notes.tableWidths","styles":{"code":true}},{"type":"text","text":", and a note in the changelog","styles":{}}],"children":[]},{"id":"769447a6-1e00-47e4-a1c1-95e6f6d31352","type":"checkListItem","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","checked":false},"content":[{"type":"text","text":"Sofia: on-call handover doc — the pool alert from ","styles":{}},{"type":"text","text":"INC-4412","styles":{"code":true}},{"type":"text","text":" is new","styles":{}}],"children":[]},{"id":"bb43e460-9000-4035-95d6-2fd38e39b54a","type":"checkListItem","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","checked":false},"content":[{"type":"text","text":"Someone: ask design for a redesign sketch before Sprint 15 planning","styles":{}}],"children":[]},{"id":"780e43e7-54b1-44bc-9980-3c0b58674663","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":2,"isToggleable":false},"content":[{"type":"text","text":"Raw notes","styles":{}}],"children":[]},{"id":"8cd6eb36-90ff-4634-b234-b2a920dfe850","type":"toggleListItem","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"The bit about the flag, in full","styles":{}}],"children":[{"id":"975d03d2-4ec3-49cc-9d7f-cf1fabf25fe1","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Mai's worry was that a half-mapped import writes rows nobody asked for, and a flag is not a rollback. The answer we landed on: the importer writes into a staging table and the flag only controls whether it can promote. Cheap, and it makes the demo honest.","styles":{}}],"children":[]}]},{"id":"1f10a2e9-be8a-46d7-a252-bfe61aa81aad","type":"toggleListItem","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"The redesign argument","styles":{}}],"children":[{"id":"ab640b10-11b1-4cfe-8f1e-c1cc8e1fa125","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Two positions, and neither is wrong: a goal makes it real, and a goal with no design makes the next four sprints look like they moved. Dropped it, with a note to revisit once there is something to look at.","styles":{}}],"children":[]}]},{"id":"7dccbc6b-bbd1-4add-b655-67cb2ba7711f","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Next planning: Monday 2026-08-31, same time.","styles":{}}],"children":[]}]