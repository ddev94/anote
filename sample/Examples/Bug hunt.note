 },
 {
  "id": "2a56e2ab-c411-4cf5-83bd-6d6899ae7b2d",
  "type": "quote",
  "props": {
   "backgroundColor": "default",
   "textColor": "default"
  },
  "content": [
   {
    "type": "text",
    "text": "The 30s was the gateway giving up, not the database. Two timeouts where the outer one is shorter means every deadlock reads as “the request vanished”.",
    "styles": {}
   }
  ],
  "children": []
 }
