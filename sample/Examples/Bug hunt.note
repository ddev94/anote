   }
  ],
  "children": []
 },
 {
  "id": "c889d97d-3e1b-420b-927e-be32e9f9ede8",
  "type": "codeBlock",
  "props": {
   "language": "sql"
  },
  "content": [
   {
    "type": "text",
    "text": "-- inside the checkout transaction\nSELECT balance FROM gift_cards WHERE code = $1 FOR UPDATE;",
    "styles": {}
   }
  ],
  "children": []
 },
 {
  "id": "8811af5b-4d0d-4434-ade3-b05e2fae4175",
  "type": "paragraph",
  "props": {
   "backgroundColor": "default",
   "textColor": "default",
   "textAlignment": "left"
  },
  "content": [
   {
    "type": "text",
    "text": "FOR UPDATE",
    "styles": {
     "code": true
    }
   },
   {
    "type": "text",
    "text": " is right. Taking it on a ",
    "styles": {}
   },
   {
    "type": "text",
    "text": "second",
    "styles": {
     "bold": true
    }
   },
   {
    "type": "text",
    "text": " connection is not: the transaction holding the row lock is on the first one, and the pool has two.",
    "styles": {}
   }
  ],
  "children": []
 },
 {
  "id": "bf268a8b-9785-4a87-bc34-453a4dcafc65",
  "type": "tabList",
  "props": {},
  "children": [
   {
    "id": "7d266a46-ecc1-4ca4-a37d-2dc2ade1240c",
    "type": "tab",
    "props": {
     "title": "Before"
    },
    "children": [
     {
      "id": "c13dc0e7-5b00-4d5c-a3ae-4f33a4ca5ee0",
      "type": "codeBlock",
      "props": {
       "language": "ts"
      },
      "content": [
       {
        "type": "text",
        "text": "await db.transaction(async (tx) => {\n  await reserveStock(tx, cart)\n  // a fresh connection out of the pool — and the lock is on tx\n  const card = await giftCards.lock(cart.giftCard)\n  await charge(tx, cart, card.balance)\n})",
        "styles": {}
       }
      ],
      "children": []
     }
    ]
   },
   {
    "id": "61171483-41d1-4051-861a-9e3e3460a94a",
    "type": "tab",
    "props": {
     "title": "After"
    },
    "children": [
     {
      "id": "1d24b2b6-f16e-403a-ac0c-53220da00d8a",
      "type": "codeBlock",
      "props": {
       "language": "ts"
      },
      "content": [
       {
        "type": "text",
        "text": "await db.transaction(async (tx) => {\n  await reserveStock(tx, cart)\n  // the same connection, so the lock is ours to take\n  const card = await giftCards.lock(cart.giftCard, tx)\n  await charge(tx, cart, card.balance)\n})",
        "styles": {}
       }
      ],
      "children": []
     }
    ]
   },
   {
    "id": "1f842590-2767-4258-9b83-8490cc884e39",
    "type": "tab",
    "props": {
     "title": "The test that would have caught it"
    },
    "children": [
     {
      "id": "fc75d684-ebce-4198-977e-c9d599209543",
      "type": "codeBlock",
      "props": {
       "language": "ts"
      },
      "content": [
       {
        "type": "text",
        "text": "test(\"two carts, one gift card, no deadlock\", async () => {\n  const both = Promise.all([checkout(cartA), checkout(cartB)])\n  await expect(both).resolves.toHaveLength(2)   // hung at 30s before the fix\n})",
        "styles": {}
       }
      ],
      "children": []
     },
     {
      "id": "6f4bf681-4665-48af-85a0-66a20f6712ff",
      "type": "paragraph",
      "props": {
       "backgroundColor": "default",
       "textColor": "default",
       "textAlignment": "left"
      },
      "content": [
       {
        "type": "text",
        "text": "It runs against a real pool of two. With a pool of ten it passes either way, which is why it was not there.",
        "styles": {}
       }
      ],
      "children": []
     }
    ]
   }
  ]
 },
