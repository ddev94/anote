 },
 {
  "id": "300dcf76-f625-4d56-8b7b-64b30d7ec40c",
  "type": "checkListItem",
  "props": {
   "backgroundColor": "default",
   "textColor": "default",
   "textAlignment": "left",
   "checked": false
  },
  "content": [
   {
    "type": "text",
    "text": "Ask whether ",
    "styles": {}
   },
   {
    "type": "text",
    "text": "statement_timeout",
    "styles": {
     "code": true
    }
   },
   {
