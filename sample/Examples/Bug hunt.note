  },
  "content": [
   {
    "type": "text",
    "text": "p99",
    "styles": {
     "code": true
    }
   },
   {
    "type": "text",
    "text": " on ",
    "styles": {}
   },
   {
    "type": "text",
    "text": "/checkout",
    "styles": {
     "code": true
    }
   },
   {
    "type": "text",
    "text": " went from 240ms to 30s at 16:41 on 08-13 — the deploy, not the traffic.",
