  },
  "content": [
   {
    "type": "text",
    "text": "Alert on ",
    "styles": {}
   },
   {
    "type": "text",
    "text": "db.pool.waiting > 0",
    "styles": {
     "code": true
    }
   },
   {
    "type": "text",
