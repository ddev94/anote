 },
 {
  "id": "1c12618e-3b44-4313-a18c-16ae7293bf61",
  "type": "paragraph",
  "props": {
   "backgroundColor": "default",
   "textColor": "default",
   "textAlignment": "left"
  },
  "content": [
   {
    "type": "text",
    "text": "One more, from below the surface: a second, smaller layout, to show that folding is per block and not per file.",
    "styles": {}
   }
  ],
  "children": []
 },
