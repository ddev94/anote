 {
  "id": "2e40359c-993e-4de9-a6bb-4eb97557e2d9",
  "type": "heading",
  "props": {
   "backgroundColor": "default",
   "textColor": "default",
   "textAlignment": "left",
   "level": 2,
   "isToggleable": false
  },
  "content": [
   {
    "type": "text",
    "text": "The configuration behind all of it",
    "styles": {}
   }
  ],
  "children": []
 },
 {
  "id": "da1f50aa-aee9-42a3-8dd4-d85375a557d3",
  "type": "codeBlock",
  "props": {
   "language": "json"
  },
  "content": [
   {
    "type": "text",
    "text": "{\n  \"$schema\": \"./schemas/anote.schema.json\",\n  \"notesDir\": \"sample\",\n  \"newNote\": { \"defaultName\": \"Untitled\" },\n  \"assets\": { \"dirSuffix\": \".assets\" },\n  \"preview\": { \"theme\": \"auto\", \"pollMs\": 2000, \"port\": 0 },\n  \"studio\": { \"enabled\": true },\n  \"mcp\": { \"enabled\": true }\n}",
    "styles": {}
   }
  ],
  "children": []
 },
 {
  "id": "5c564f52-04ca-48ad-bee4-fe18678c6c30",
  "type": "paragraph",
  "props": {
   "backgroundColor": "default",
   "textColor": "default",
   "textAlignment": "left"
  },
  "content": [
   {
    "type": "text",
    "text": "One optional file at the root of the workspace folder, watched: writing it redraws the open previews and re-offers the MCP servers. Nothing in it can stop the extension starting — a value that does not check out is replaced with the default and reported once.",
    "styles": {}
   }
  ],
  "children": []
 },
 {
  "id": "0be47075-c52a-48f2-8af6-60713ad1ea66",
  "type": "toggleListItem",
  "props": {
   "backgroundColor": "default",
   "textColor": "default",
   "textAlignment": "left"
  },
  "content": [
   {
    "type": "text",
    "text": "Why it is a file in the repository and not a VS Code setting",
    "styles": {}
   }
  ],
  "children": [
   {
    "id": "2c319ae6-439d-4ca0-887f-db7aae2d37eb",
    "type": "paragraph",
    "props": {
     "backgroundColor": "default",
     "textColor": "default",
     "textAlignment": "left"
    },
    "content": [
     {
      "type": "text",
      "text": "Where notes live, and what the folder beside them is called, are facts about the repository: the same for everyone who clones it. Which palette ",
      "styles": {}
     },
     {
      "type": "text",
      "text": "you",
      "styles": {
       "bold": true
      }
     },
     {
      "type": "text",
      "text": " read previews in is not, which is why the theme switch lives in ",
      "styles": {}
     },
     {
      "type": "text",
      "text": "globalState",
      "styles": {
       "code": true
      }
     },
     {
      "type": "text",
      "text": " instead.",
      "styles": {}
     }
    ],
    "children": []
   }
  ]
 }
]
