  "type": "paragraph",
  "props": {
   "backgroundColor": "default",
   "textColor": "default",
   "textAlignment": "left"
  },
  "content": [
   {
    "type": "text",
    "text": "Every line in a note is a block, and every block came out of one menu. Type ",
    "styles": {}
   },
   {
    "type": "text",
    "text": "/",
    "styles": {
     "code": true
    }
   },
   {
    "type": "text",
    "text": " and the list below is what you get; the point of this note is that you can drag any of it, tint any of it, and nest most of it.",
    "styles": {}
   }
  ],
  "children": []
 },
 {
  "id": "f80a8a51-0290-4dd1-ad16-dd4cc1b69a06",
  "type": "divider",
  "props": {},
  "children": []
 },
