  "type": "toggleListItem",
  "props": {
   "backgroundColor": "default",
   "textColor": "default",
   "textAlignment": "left"
  },
  "content": [
   {
    "type": "text",
    "text": "A toggle list is a fold, and it starts shut",
    "styles": {}
   }
  ],
  "children": [
   {
    "id": "15d415a4-9dc8-4c7d-9240-5a1d7200c37a",
    "type": "paragraph",
    "props": {
     "backgroundColor": "default",
     "textColor": "default",
     "textAlignment": "left"
    },
    "content": [
     {
      "type": "text",
      "text": "Whatever is inside is a block like any other: paragraphs, code, a table, another toggle. Which one is open is remembered per block and never reaches the file, so the note is the same document for everyone who opens it.",
      "styles": {}
     }
    ],
    "children": []
   },
   {
    "id": "206c8216-36ef-410e-981b-75c30cd76ff7",
