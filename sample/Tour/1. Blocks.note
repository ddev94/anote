  "props": {
   "backgroundColor": "default",
   "textColor": "default",
   "textAlignment": "left"
  },
  "content": [
   {
    "type": "text",
    "text": "Headings go to six levels; three of them are one keystroke: `#`, `##`, `###` followed by a space.",
    "styles": {}
   }
  ],
  "children": []
 },
 {
