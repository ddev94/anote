  "props": {
   "backgroundColor": "default",
   "textColor": "default"
  },
  "content": [
   {
    "type": "text",
    "text": "A quote is one block with its own bar down the left, and it takes children — so a quote can hold a list, or a second paragraph.",
    "styles": {}
   }
  ],
  "children": []
 },
 {
  "id": "71508088-1d0c-4db3-9f47-1a44ba9d693b",
