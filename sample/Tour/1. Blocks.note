 },
 {
  "id": "04895704-c302-4030-bffd-bb035d58fe6a",
  "type": "paragraph",
  "props": {
   "backgroundColor": "default",
   "textColor": "default",
   "textAlignment": "left"
  },
  "content": [
   {
    "type": "text",
    "text": "A code block keeps its language, and the language is what a highlighter reads:",
    "styles": {}
   }
  ],
  "children": []
 },
 {
  "id": "17742b45-3a09-4611-9e20-f99d3f6abafe",
  "type": "codeBlock",
  "props": {
   "language": "ts"
  },
  "content": [
   {
    "type": "text",
    "text": "/** The only fact both sides of the extension read. */\nexport type Edit = {\n  type: \"edit\"\n  text: string     // the whole note, as it should be on disk\n}\n\n// A note is a file, so this is all \"save\" has to mean.\nexport const save = (edit: Edit) => writeFile(note, edit.text)",
    "styles": {}
   }
  ],
  "children": []
 },
 {
  "id": "46337f14-1ff8-498f-ac65-44491a9a025e",
  "type": "codeBlock",
  "props": {
   "language": "bash"
  },
  "content": [
   {
    "type": "text",
    "text": "bun run build      # four bundles: extension, webview, studio, mcp\nbun run test       # the renderer, the routes, the converters",
    "styles": {}
   }
  ],
  "children": []
 },
 {
