       "textColor": "default",
       "textAlignment": "left"
      },
      "content": [
       {
        "type": "text",
        "text": "The same editor, with a shorter menu: markdown has nowhere to put a toggle list, a colour or a tab group, so those are taken out of the schema rather than hidden.",
        "styles": {}
       }
      ],
      "children": []
     },
