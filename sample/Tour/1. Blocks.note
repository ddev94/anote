   "backgroundColor": "yellow",
   "textColor": "default",
   "textAlignment": "left"
  },
  "content": [
   {
    "type": "text",
    "text": "A block can be tinted, which is a property of the block rather than of the words in it.",
    "styles": {}
   }
  ],
  "children": []
 },
 {
  "id": "f451ae12-4259-4222-bad9-31b293b7bfb3",
