[
 {
  "id": "a0bf794d-410d-4e11-ab66-b812075e0263",
  "type": "heading",
  "props": {
   "backgroundColor": "default",
   "textColor": "default",
   "textAlignment": "left",
   "level": 1,
   "isToggleable": false
  },
  "content": [
   {
    "type": "text",
    "text": "Notes an agent can edit",
    "styles": {}
   }
  ],
  "children": []
 },
 {
  "id": "60ac7437-3415-43a1-873a-c063232f054e",
  "type": "paragraph",
  "props": {
   "backgroundColor": "default",
   "textColor": "default",
   "textAlignment": "left"
  },
  "content": [
   {
    "type": "text",
    "text": "A note is a file, and a file needs no application to be edited. So the notes folder is also an ",
    "styles": {}
   },
   {
    "type": "link",
    "href": "https://modelcontextprotocol.io",
    "content": [
     {
      "type": "text",
      "text": "MCP",
      "styles": {}
     }
    ]
   },
   {
    "type": "text",
    "text": " server: a small process with seven tools over these same ",
    "styles": {}
   },
   {
    "type": "text",
    "text": ".note",
    "styles": {
     "code": true
    }
   },
   {
    "type": "text",
    "text": " files.",
    "styles": {}
   }
  ],
  "children": []
 },
 {
  "id": "84f62d9b-6eb8-462b-981f-ef1f644fba44",
  "type": "quote",
  "props": {
   "backgroundColor": "default",
   "textColor": "default"
  },
  "content": [
   {
    "type": "text",
    "text": "For the editor's own agent there is nothing to register. Installing the extension is the whole configuration — one server per workspace folder, each rooted at that folder. Check ",
    "styles": {}
   },
   {
    "type": "text",
    "text": "MCP: List Servers",
    "styles": {
     "bold": true
    }
   },
   {
    "type": "text",
    "text": " and look for “ANote”.",
    "styles": {}
   }
  ],
  "children": []
 },
 {
  "id": "57fc24ba-2f0a-4baa-a39b-522f2f0f0fff",
  "type": "paragraph",
  "props": {
   "backgroundColor": "default",
   "textColor": "default",
   "textAlignment": "left"
  },
  "content": [
   {
    "type": "text",
    "text": "Every other client is told a path and a folder, which is what ",
    "styles": {}
   },
   {
    "type": "text",
    "text": ".mcp.json",
    "styles": {
     "code": true
    }
   },
   {
    "type": "text",
    "text": " at the root is for:",
    "styles": {}
   }
  ],
  "children": []
 },
 {
  "id": "2ec33464-bd55-4ebd-ad91-47f74ea38e17",
  "type": "codeBlock",
  "props": {
   "language": "bash"
  },
  "content": [
   {
    "type": "text",
    "text": "bun run build          # dist/mcp.js falls out with the other bundles\nnode dist/mcp.js       # the folder it starts in, or argv[2], or $ANOTE_ROOT",
    "styles": {}
   }
  ],
  "children": []
 },
 {
